# Copy to terraform.tfvars and adjust. terraform.tfvars is gitignored.
# Secrets are better passed as environment variables:
#
#   export TF_VAR_github_token=ghp_xxxxxxxxxxxx
#   export TF_VAR_grafana_admin_password='...'
#   export TF_VAR_jenkins_admin_password='...'
#   export TF_VAR_db_password='...'          # omit and Terraform generates one

aws_region   = "us-east-1"
project_name = "final-project"
environment  = "dev"

# State backend — the values here must match the block in backend.tf.
# S3 bucket names are globally unique, so change the prefix if you fork this.
state_bucket_name     = "denys-finchenko-tf-state-final-project"
state_lock_table_name = "terraform-locks-final-project"

# Network
vpc_cidr_block  = "10.0.0.0/16"
public_subnets  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnets = ["10.0.4.0/24", "10.0.5.0/24", "10.0.6.0/24"]

# EKS. m7i-flex.large is what this account was verified on — a node group with an
# instance type the account cannot launch hangs in CREATING without an error.
cluster_name        = "final-project-eks"
kubernetes_version  = "1.34"
node_instance_types = ["m7i-flex.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

# Database. use_aurora = true switches to an Aurora PostgreSQL cluster — it also
# needs a bigger class, Aurora does not run on db.t3.micro.
use_aurora                 = false
db_instance_class          = "db.t3.micro"
db_name                    = "djangodb"
db_username                = "djangouser"
db_backup_retention_period = 1

# Git — Jenkins pushes the new image.tag here and Argo CD tracks the same branch.
github_owner  = "dfinchenko"
github_repo   = "my-microservice-project"
github_branch = "final-project"

# Monitoring. LoadBalancer publishes Grafana and adds an ELB to the bill;
# ClusterIP keeps it behind kubectl port-forward.
grafana_service_type = "ClusterIP"
prometheus_retention = "3d"
